{
	"schemaVersion": 1,
	"id": "avp_alien",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"accessWidener": "avp_alien.accesswidener",
	"authors": [],
	"contact": {
		"homepage": "${mod_url}",
		"issues": "${mod_issues}",
		"sources": "${mod_sources}"
	},
	"license": "${mod_license}",
	"icon": "${mod_logo}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.alien.fabric.AlienFabric"
		],
		"client": [
			"com.alien.fabric.client.AlienFabricClient"
		],
		"fabric-datagen": [
			"com.alien.fabric.data.AlienDataGenerator"
		],
		"rei_client": [],
		"jei_mod_plugin": []
	},
	"mixins": [
		"${mod_id}.mixins.json",
		"${mod_id}.fabric.mixins.json"
	],
	"breaks": {
		"gigeresque": "<${gigeresque_version}"
	},
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"blib": "~${blib_version}"
	},
	"suggests": {
		"avp_human": "~${avp_human_version}",
		"avp_predator": "~${avp_predator_version}",
		"gigeresque": "~${gigeresque_version}",
		"blib_engine": "~${blib_engine_version}"
	}
}
